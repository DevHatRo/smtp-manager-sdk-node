{
  "name": "@devhatro/smtp-manager-sdk",
  "version": "0.0.0",
  "description": "Zero-dependency Node.js SDK for the SMTP Manager transactional send API",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/ test/ && prettier --check src/ test/",
    "lint:fix": "eslint --fix src/ test/ && prettier --write src/ test/",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --project unit --coverage",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "smtp",
    "email",
    "transactional",
    "mail",
    "smtp-manager",
    "sdk"
  ],
  "author": "DevHat",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DevHatRo/smtp-manager-sdk-node.git"
  },
  "homepage": "https://github.com/DevHatRo/smtp-manager-sdk-node#readme",
  "bugs": {
    "url": "https://github.com/DevHatRo/smtp-manager-sdk-node/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.9",
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "@vitest/coverage-v8": "^3.0.5",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.0.1",
    "prettier": "^3.5.2",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
